msgstr "2.按聚合条件查询表"

#: ../../source/get_started/play_with_dingo_using_sql.md:81 853cc43922cd4924ac2488858d50b771
msgid "3.Query table by `order by`"
msgstr "3.排序查询"

#: ../../source/get_started/play_with_dingo_using_sql.md:87 60dd142770594ceb99c8a1f24de12454
msgid "4.Update table by row or condition"
msgstr "4.按行或条件更新表"

