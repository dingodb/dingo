msgid "Vector Index"
msgstr "向量索引"

#: ../../source/deployment/sql_operations.md c03664df30824acca2e582d4e9cda0af
msgid ""
"Creates an index on a vector field, the index type should be specified as "
"`VECTOR`."
msgstr "为向量场创建索引，索引类型应指定为 `VECTOR`。"

#: ../../source/deployment/sql_operations.md df39df7c0a374e7898fcb5f2deaacf95
#, python-brace-format
msgid "INDEX[index_name ]VECTOR( {index_parameters} )"
msgstr ""

#: ../../source/deployment/sql_operations.md f20939ae46fe4639a9a942bcf020df81
msgid "Scalar Index"
msgstr "标量索引"

#: ../../source/deployment/sql_operations.md e782b3cd888b4844ae251a0c884c6996
msgid ""
"Index created on a scalar field, default index type is scalar, `Scalar` is "
"optional."
msgstr "在标量字段上创建索引，默认索引类型为标量，“Scalar ”为可选项。"

